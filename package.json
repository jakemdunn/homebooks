{
  "name": "homebooks",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names firefox,chrome --prefix-colors yellow,cyan \"pnpm dev:firefox\" \"pnpm dev:chrome\"",
    "dev:chrome": "TARGET=chrome OUT_DIR=dist/chrome vite dev",
    "dev:firefox": "TARGET=firefox OUT_DIR=dist/firefox vite dev",
    "watch": "vite build --watch --mode development",
    "build": "tsc && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "build:e2e": "TARGET=chrome OUT_DIR=dist-e2e vite build",
    "test:e2e": "pnpm build:e2e && playwright test",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p e2e && tsc --noEmit -p build && tsc --noEmit -p .storybook",
    "storybook": "storybook dev --port 6006",
    "build:storybook": "storybook build --output-dir dist-storybook",
    "test:visual": "pnpm build:storybook && playwright test -c visual",
    "test:visual:update": "pnpm build:storybook && playwright test -c visual --update-snapshots"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@vanilla-extract/css": "^1.21.3",
    "@vanilla-extract/dynamic": "^2.1.5",
    "fast-deep-equal": "^3.1.3",
    "formik": "^2.4.9",
    "fuzzysort": "^4.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-resize-detector": "^12.3.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/rubik-mono-one": "^5.3.0",
    "@playwright/test": "^1.65.0",
    "@storybook/react-vite": "^10.6.7",
    "@types/chrome": "^0.3.7",
    "@types/firefox-webext-browser": "^143.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/webextension-polyfill": "^0.12.6",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "3.9.10",
    "storybook": "^10.6.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vite-plugin-web-extension": "^4.5.1",
    "vitest": "^5.1.0",
    "webextension-polyfill": "^0.12.0"
  }
}
